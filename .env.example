# ========================================================
# TrustVault - Environment Configuration Template
# ========================================================
# Copy this file to .env.local for local development.
# NEVER commit your actual .env or .env.local file to git!
# ========================================================

# Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (client-safe for browser auth)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT!)
# Used strictly for server-mediated file delivery from private bucket,
# tamper-evident audit logging, and administrative tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Base URL (for auth redirects and correlation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
